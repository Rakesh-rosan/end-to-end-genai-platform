# Copy to .env and edit.  Every value here has a safe default in app/config.py.

# --- LLM ---------------------------------------------------------------
# "mock" runs fully offline (deterministic, no key).
# "anthropic" calls Claude, "openai" calls OpenAI. Uncomment ONE block below.
LLM_PROVIDER=mock

# --- Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_ROUTER_MODEL=claude-opus-5-5
# LLM_EFFORT=low

# --- OpenAI ---
# Use any chat model your account has access to (see platform.openai.com/docs/models).
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# The router only emits one label, so a cheaper model is a common choice here.
# Measure intent accuracy with evals/run_eval.py before and after changing it.
# LLM_ROUTER_MODEL=gpt-4o-mini

# --- Embeddings --------------------------------------------------------
# "hashing" = zero-download lexical embedder (good for learning).
# "sentence-transformers" = real semantic embeddings (pip install sentence-transformers).
# "openai" = text-embedding-3-small (uses OPENAI_API_KEY; small cost per request).
EMBEDDING_PROVIDER=hashing

# --- Gateway -----------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me-in-production-0001
RATE_LIMIT_PER_MINUTE=20
# Set when running more than one replica so limits are shared:
# REDIS_URL=redis://localhost:6379/0

# --- Cache / RAG / HITL ------------------------------------------------
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
REFUND_HITL_THRESHOLD=200
